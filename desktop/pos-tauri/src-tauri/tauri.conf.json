{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NutriFresh POS",
  "version": "1.3.3",
  "identifier": "id.my.nutrifresh.pos",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NutriFresh POS \u2014 Kasir & Operasional Toko",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
